{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tree_snapshot.schema.json",
  "title": "TreeSnapshot",
  "type": "object",
  "required": ["schema_version", "run_id", "root_path", "generated_at", "nodes"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "root_path": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "required": ["root_path", "subtree_path", "path_format"],
      "properties": {
        "root_path": { "type": "string" },
        "subtree_path": { "type": "string" },
        "path_format": { "const": "posix" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_artifacts": { "type": "array", "items": { "type": "object" } },
        "derived_from": { "type": "string" },
        "derived_from_hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "path", "type"],
        "properties": {
          "node_id": { "type": "string" },
          "path": { "type": "string" },
          "type": { "enum": ["file", "directory", "symlink"] },
          "size_bytes": { "type": ["integer", "null"] },
          "mtime": { "type": ["string", "null"], "format": "date-time" },
          "ctime": { "type": ["string", "null"], "format": "date-time" },
          "extension": { "type": ["string", "null"] },
          "content_type": { "type": ["string", "null"] },
          "content_hash": { "type": ["string", "null"] },
          "symlink_target": { "type": ["string", "null"] },
          "permissions": { "type": ["string", "null"] },
          "availability": { "enum": ["available", "cloud_only", "unknown"] }
        }
      }
    }
  }
}
