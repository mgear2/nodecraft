{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposal.schema.json",
  "title": "Proposal",
  "type": "object",
  "required": ["schema_version", "proposal_id", "run_id", "iteration", "based_on_input_hash", "diagram", "changes"],
  "properties": {
    "schema_version": { "type": "string" },
    "proposal_id": { "type": "string" },
    "run_id": { "type": "string" },
    "iteration": { "type": "integer", "minimum": 1 },
    "based_on_input_hash": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["root_path", "subtree_path", "path_format"],
      "properties": {
        "root_path": { "type": "string" },
        "subtree_path": { "type": "string" },
        "path_format": { "const": "posix" }
      },
      "additionalProperties": true
    },
    "origin": {
      "type": "object",
      "required": ["root_path", "subtree_path", "path_format"],
      "properties": {
        "root_path": { "type": "string" },
        "subtree_path": { "type": "string" },
        "path_format": { "const": "posix" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_artifacts": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "diagram": { "type": "string" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "action", "from_path"],
        "properties": {
          "node_id": { "type": "string" },
          "action": { "enum": ["move", "rename", "delete", "archive"] },
          "from_path": { "type": "string" },
          "to_path": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "enum": ["move", "rename"] } } },
            "then": {
              "required": ["to_path"],
              "properties": { "to_path": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    }
  }
}
